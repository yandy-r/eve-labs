{
  "name": "eve-labs",
  "private": true,
  "description": "EVE-NG Pro lab topology files",
  "packageManager": "pnpm@10.18.3",
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "lint": "./scripts/style.sh lint",
    "lint:modified": "./scripts/style.sh lint --modified",
    "lint:staged": "./scripts/style.sh lint --staged",
    "lint:unstaged": "./scripts/style.sh lint --unstaged",
    "lint:fix": "./scripts/style.sh lint --fix",
    "lint:fix:modified": "./scripts/style.sh lint --fix --modified",
    "format": "./scripts/style.sh format",
    "format:modified": "./scripts/style.sh format --modified",
    "format:staged": "./scripts/style.sh format --staged",
    "format:unstaged": "./scripts/style.sh format --unstaged",
    "test": "./scripts/check-labs.py",
    "fix-perms": "./scripts/fix-lab-permissions.sh"
  },
  "commitlint": {
    "extends": ["@commitlint/config-conventional"],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "refactor",
          "perf",
          "test",
          "build",
          "ci",
          "chore",
          "style",
          "revert"
        ]
      ],
      "subject-case": [2, "never", ["pascal-case", "upper-case"]],
      "header-max-length": [2, "always", 100],
      "body-max-line-length": [0]
    }
  },
  "license": "MIT"
}
